@@ -46,6 +46,11 @@ export enum KeybindAction {
    */
   CHAT_CANCEL_EDITING = "chat_cancel_editing",
 
+  /**
+   * Open message search for the current channel and focus the search field
+   */
+  CHAT_SEARCH = "chat_search",
+
   /**
    * Close the currently active modal
    */
@@ -82,9 +87,23 @@ export const ACTION_PRIORITY: KeybindAction[] = [
   KeybindAction.NAVIGATION_CHANNEL_DOWN,
 
   // ... all others
+  KeybindAction.CHAT_SEARCH,
   KeybindAction.CHAT_FOCUS_COMPOSITION,
 ];
 
+/**
+ * Actions that must suppress the browser's own handling of the sequence.
+ *
+ * Only listed here when the app fully replaces the native behaviour, since
+ * taking a browser shortcut away from the user is otherwise hostile. Ctrl+F
+ * qualifies: the native find bar only searches messages already rendered in
+ * the DOM, which for a virtualised, paginated channel is a misleading subset
+ * of the conversation.
+ */
+export const PREVENT_DEFAULT_ACTIONS: ReadonlySet<KeybindAction> = new Set([
+  KeybindAction.CHAT_SEARCH,
+]);
+
 /**
  * Filter keybinds with special logic
  * @param keybind Keybind to filter
@@ -97,6 +116,16 @@ export function keybindFilter(
   currentlyBound: Record<KeybindAction, number>,
   target: HTMLElement | null,
 ) {
+  if (keybind === KeybindAction.CHAT_SEARCH) {
+    // a modal or floating element owns the screen, so leave the shortcut to
+    // the browser rather than opening a sidebar the user cannot see
+    if (
+      currentlyBound[KeybindAction.CLOSE_FLOATING] ||
+      currentlyBound[KeybindAction.CLOSE_MODAL]
+    )
+      return false;
+  }
+
   if (keybind === KeybindAction.CHAT_FOCUS_COMPOSITION) {
     // don't allow focusing if modal/floating is open
     // or if we're editing a message
diff --git a/packages/client/components/keybinds/keybindHandler.tsx b/packages/client/components/keybinds/keybindHandler.tsx
index 203172f6..56df0d55 100644
--- a/packages/client/components/keybinds/keybindHandler.tsx
+++ b/packages/client/components/keybinds/keybindHandler.tsx
@@ -12,6 +12,7 @@ import {
   ACTION_PRIORITY,
   KeybindAction,
   keybindFilter,
+  PREVENT_DEFAULT_ACTIONS,
 } from "./keybindActions";
 import { DEFAULT_MAC_SEQUENCES, DEFAULT_SEQUENCES } from "./keybindSequences";
 
@@ -119,6 +120,22 @@ export function KeybindContext(props: { children: JSXElement }) {
   function onKeyDown(event: KeyboardEvent) {
     target = event.target as HTMLElement;
     activeKeys.add(event.key);
+
+    // Suppress the browser's own handling for the few sequences the app
+    // replaces outright. Checked after the key is registered so that the
+    // sequence being completed by this very event is taken into account.
+    // Guarded on something being bound first, so the common case of typing a
+    // message does not walk the priority list on every keystroke.
+    const anyBound = [...PREVENT_DEFAULT_ACTIONS].some(
+      (action) => currentlyBound[action],
+    );
+
+    if (anyBound) {
+      const action = firing();
+      if (action && PREVENT_DEFAULT_ACTIONS.has(action)) {
+        event.preventDefault();
+      }
+    }
   }
 
   /**
@@ -126,6 +143,15 @@ export function KeybindContext(props: { children: JSXElement }) {
    */
   function onKeyUp(event: KeyboardEvent) {
     target = event.target as HTMLElement;
+
+    // While Command is held on macOS the browser does not deliver keyup for
+    // other keys, so those would stay in the set forever and make the next
+    // Command press fire a stale sequence. Releasing Command clears everything.
+    if (event.key === "Meta") {
+      activeKeys.clear();
+      return;
+    }
+
     activeKeys.delete(event.key);
   }
 
