diff --git a/packages/client/components/modal/modals/QuickSwitcher.tsx b/packages/client/components/modal/modals/QuickSwitcher.tsx
new file mode 100644
index 00000000..cbcebac9
--- /dev/null
+++ b/packages/client/components/modal/modals/QuickSwitcher.tsx
@@ -0,0 +1,323 @@
+import {
+  For,
+  Show,
+  createEffect,
+  createMemo,
+  createSignal,
+  on,
+} from "solid-js";
+
+import { Trans, useLingui } from "@lingui-solid/solid/macro";
+import { styled } from "styled-system/jsx";
+
+import { useNavigate } from "@revolt/routing";
+import { Dialog, DialogProps } from "@revolt/ui";
+
+import { Modals } from "../types";
+
+/**
+ * How many results to render at once
+ */
+const RESULT_LIMIT = 12;
+
+/**
+ * One thing the switcher can jump to
+ */
+type Entry = {
+  id: string;
+  /**
+   * What the user is searching against
+   */
+  label: string;
+  /**
+   * Where it lives, shown to the right of the label
+   */
+  context?: string;
+  /**
+   * Prefix marking what kind of thing this is
+   */
+  sigil: string;
+  path: string;
+};
+
+/**
+ * Score a candidate against a query.
+ *
+ * Deliberately forgiving, in three tiers: a prefix beats a substring, and a
+ * substring beats characters merely appearing in order. Returning null means
+ * no match at all. Everything is compared lowercased, so capitalisation never
+ * decides whether a result appears.
+ */
+function scoreEntry(label: string, query: string): number | null {
+  const haystack = label.toLowerCase();
+  const needle = query.toLowerCase();
+
+  if (haystack.startsWith(needle)) return 1000 - haystack.length;
+
+  const index = haystack.indexOf(needle);
+  if (index !== -1) {
+    // A match starting a word reads as more deliberate than one mid-word.
+    const onBoundary = index === 0 || /[\s\-_#]/.test(haystack[index - 1]);
+    return (onBoundary ? 700 : 500) - index - haystack.length / 100;
+  }
+
+  // Subsequence fallback: "gac" finds "general-accounts".
+  let cursor = 0;
+  let gaps = 0;
+  for (const character of needle) {
+    const found = haystack.indexOf(character, cursor);
+    if (found === -1) return null;
+    gaps += found - cursor;
+    cursor = found + 1;
+  }
+
+  return 200 - gaps;
+}
+
+/**
+ * Jump to any server, channel or conversation by name
+ */
+export function QuickSwitcherModal(
+  props: DialogProps & Modals & { type: "quick_switcher" },
+) {
+  const { t } = useLingui();
+  const navigate = useNavigate();
+
+  const [query, setQuery] = createSignal("");
+  const [selected, setSelected] = createSignal(0);
+
+  let inputRef: HTMLInputElement | undefined;
+
+  // The dialog mounts before the field exists, so focusing waits a tick.
+  createEffect(
+    on(
+      () => props.show,
+      (show) => {
+        if (show) {
+          queueMicrotask(() => inputRef?.focus());
+        } else {
+          setQuery("");
+          setSelected(0);
+        }
+      },
+    ),
+  );
+
+  /**
+   * Everything reachable, flattened into one searchable list
+   */
+  const entries = createMemo<Entry[]>(() => {
+    const out: Entry[] = [];
+
+    for (const server of props.client.servers.toList()) {
+      out.push({
+        id: server.id,
+        label: server.name,
+        sigil: "▸",
+        path: `/server/${server.id}`,
+      });
+    }
+
+    for (const channel of props.client.channels.toList()) {
+      const label = channel.displayName;
+      if (!label) continue;
+
+      if (channel.serverId) {
+        out.push({
+          id: channel.id,
+          label,
+          context: channel.server?.name,
+          sigil: "#",
+          path: channel.path,
+        });
+      } else if (channel.type === "DirectMessage" || channel.type === "Group") {
+        out.push({
+          id: channel.id,
+          label,
+          context: channel.type === "Group" ? t`Group` : t`Direct message`,
+          sigil: "@",
+          path: channel.path,
+        });
+      }
+    }
+
+    return out;
+  });
+
+  /**
+   * Entries matching the current query, best first
+   */
+  const results = createMemo(() => {
+    const search = query().trim();
+    if (!search) return entries().slice(0, RESULT_LIMIT);
+
+    return entries()
+      .map((entry) => ({ entry, score: scoreEntry(entry.label, search) }))
+      .filter((scored) => scored.score !== null)
+      .sort((a, b) => b.score! - a.score!)
+      .slice(0, RESULT_LIMIT)
+      .map((scored) => scored.entry);
+  });
+
+  // Keep the highlight in range as results change under it.
+  createEffect(
+    on(results, (list) => {
+      if (selected() >= list.length) setSelected(0);
+    }),
+  );
+
+  /**
+   * Navigate to an entry and dismiss
+   */
+  function choose(entry: Entry | undefined) {
+    if (!entry) return;
+    navigate(entry.path);
+    props.onClose();
+  }
+
+  /**
+   * Drive the list from the text field so the caret never has to leave it
+   */
+  function onKeyDown(event: KeyboardEvent) {
+    const list = results();
+
+    if (event.key === "ArrowDown") {
+      event.preventDefault();
+      setSelected((current) => (current + 1) % Math.max(list.length, 1));
+    } else if (event.key === "ArrowUp") {
+      event.preventDefault();
+      setSelected(
+        (current) => (current - 1 + list.length) % Math.max(list.length, 1),
+      );
+    } else if (event.key === "Enter") {
+      event.preventDefault();
+      choose(list[selected()]);
+    }
+  }
+
+  return (
+    <Dialog
+      show={props.show}
+      onClose={props.onClose}
+      title={<Trans>Jump to</Trans>}
+    >
+      <Field
+        ref={inputRef}
+        type="search"
+        aria-label={t`Jump to a server, channel or conversation`}
+        placeholder={t`Jump to a server, channel or conversation`}
+        value={query()}
+        onInput={(event) => {
+          setQuery(event.currentTarget.value);
+          setSelected(0);
+        }}
+        onKeyDown={onKeyDown}
+      />
+
+      <Results role="listbox">
+        <For each={results()}>
+          {(entry, index) => (
+            <Result
+              role="option"
+              type="button"
+              aria-selected={index() === selected()}
+              data-active={index() === selected() ? "" : undefined}
+              onMouseEnter={() => setSelected(index())}
+              onClick={() => choose(entry)}
+            >
+              <Sigil>{entry.sigil}</Sigil>
+              <Label>{entry.label}</Label>
+              <Show when={entry.context}>
+                <Context>{entry.context}</Context>
+              </Show>
+            </Result>
+          )}
+        </For>
+
+        <Show when={results().length === 0}>
+          <Empty>
+            <Trans>Nothing matches that.</Trans>
+          </Empty>
+        </Show>
+      </Results>
+    </Dialog>
+  );
+}
+
+const Field = styled("input", {
+  base: {
+    width: "100%",
+    padding: "var(--gap-md)",
+    borderRadius: "var(--borderRadius-md)",
+    border: "none",
+    background: "var(--md-sys-color-surface-container-highest)",
+    color: "var(--md-sys-color-on-surface)",
+    fontSize: "1rem",
+  },
+});
+
+const Results = styled("div", {
+  base: {
+    display: "flex",
+    flexDirection: "column",
+    gap: "2px",
+    marginTop: "var(--gap-md)",
+    minWidth: "320px",
+    maxHeight: "320px",
+    overflowY: "auto",
+  },
+});
+
+const Result = styled("button", {
+  base: {
+    display: "flex",
+    alignItems: "center",
+    gap: "var(--gap-md)",
+    width: "100%",
+    padding: "var(--gap-md)",
+    border: "none",
+    borderRadius: "var(--borderRadius-md)",
+    background: "transparent",
+    color: "var(--md-sys-color-on-surface)",
+    cursor: "pointer",
+    textAlign: "start",
+
+    "&[data-active]": {
+      background: "var(--md-sys-color-surface-container-highest)",
+    },
+  },
+});
+
+const Sigil = styled("span", {
+  base: {
+    flexShrink: 0,
+    width: "1rem",
+    textAlign: "center",
+    color: "var(--md-sys-color-on-surface-variant)",
+  },
+});
+
+const Label = styled("span", {
+  base: {
+    overflow: "hidden",
+    textOverflow: "ellipsis",
+    whiteSpace: "nowrap",
+  },
+});
+
+const Context = styled("span", {
+  base: {
+    marginInlineStart: "auto",
+    paddingInlineStart: "var(--gap-md)",
+    flexShrink: 0,
+    fontSize: "0.8rem",
+    color: "var(--md-sys-color-on-surface-variant)",
+  },
+});
+
+const Empty = styled("div", {
+  base: {
+    padding: "var(--gap-md)",
+    color: "var(--md-sys-color-on-surface-variant)",
+  },
+});
